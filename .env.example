APP_PORT=8001

# Gemini API key (kept on the server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# BHASHINI OCR inference key from your Udyat app profile
BHASHINI_INFERENCE_API_KEY=
BHASHINI_OCR_SERVICE_ID=bhashini/ocr-v2
BHASHINI_OCR_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ULCA credentials used to configure ASR, translation, and TTS pipelines
BHASHINI_ULCA_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_ASR_PIPELINE_ID=
BHASHINI_TRANSLATION_PIPELINE_ID=
BHASHINI_TTS_PIPELINE_ID=
